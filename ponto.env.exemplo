# Copie para "ponto.env" (mesma pasta) e preencha. O ponto.env nao vai pro git.
# Variavel de ambiente de verdade ganha do que estiver aqui.

# Senha desta maquina (obrigatoria se ela estiver exposta na internet)
# PONTO_SENHA=

# Mandar os turnos daqui pra um Ponto central (deixe vazio pra nao mandar)
# PONTO_ENVIAR_PARA=https://ponto.seudominio.com
# PONTO_ENVIAR_SENHA=a-PONTO_SENHA-do-central
# PONTO_ENVIAR_A_CADA=300
# PONTO_NOME=notebook
# Deixar o central controlar esta maquina (so acoes do Ponto)
# PONTO_ACEITAR_COMANDOS=1

# PONTO_PORTA=8095
# TZ=America/Sao_Paulo
