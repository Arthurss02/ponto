# Servico de usuario do systemd (Linux), sem root:
#   mkdir -p ~/.config/systemd/user
#   cp extras/ponto.service ~/.config/systemd/user/
#   (ajuste o caminho do ExecStart e a senha abaixo)
#   systemctl --user daemon-reload && systemctl --user enable --now ponto
#   loginctl enable-linger $USER     # continua rodando depois do logout
[Unit]
Description=Ponto - cronometro da semana
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/ponto/servidor/ponto.py
Environment=PONTO_PORTA=8095
Environment=PONTO_BANCO=%h/.local/share/ponto/ponto.db
# Environment=PONTO_SENHA=troque-esta-senha
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
